{
  "schema_version": "runtime_rebinding_plan_v1",
  "fresh_allowed_roots": [
    "data/raw",
    "contracts",
    "src",
    "runs/<run_id>"
  ],
  "frozen_policy": "comparison/reference/verification only",
  "rebinding": {
    "archive/DEPLOYED_RELEASE": "runs/<run_id>/stage outputs",
    "configs/current": "contracts/scientific and contracts/llm",
    "data/final_freeze": "runs/<run_id>/stage8 or stage9",
    "frozen/original_release": "never a fresh compute parent",
    "frozen/evidence": "comparison/reference only"
  },
  "missing_internal_modules": []
}
