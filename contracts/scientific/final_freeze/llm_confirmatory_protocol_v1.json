  "waves": {"wave1_conditions": ["C4", "C5", "PROBE"], "wave2_conditions": ["C4R", "C6", "C6X", "C7"], "branch_rule": "C4R/C6/C6X branch independently from the same raw C4; C7 branches from raw C5"},
  "reference_draw_seed": 73019,
  "retry_contract": {
