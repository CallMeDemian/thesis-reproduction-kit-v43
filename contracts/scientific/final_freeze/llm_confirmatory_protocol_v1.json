  "matrix": {
    "core": {"information": ["IC-b"], "action_modes": ["free_form_managerial_9d"], "budgets": ["LOW", "MEDIUM", "HIGH", "UNCONSTRAINED"], "conditions": ["C4", "C4R", "C6"], "replicate_ids": [1]},
    "reference_source": {"information": "IC-b", "budget": "MEDIUM", "action_mode": "free_form_managerial_9d", "additional_conditions": ["C6X"]},
    "diagnosis_scaffold": {"information": "IC-b", "budget": "MEDIUM", "action_mode": "free_form_managerial_9d", "conditions": ["C5", "C7"]},
    "action_space": {"information": "IC-b", "budget": "MEDIUM", "action_mode": "candidate_selection", "conditions": ["C4", "C6"]},
    "information": {"budget": "MEDIUM", "action_mode": "free_form_managerial_9d", "additional_information": ["IC-a", "IC-c"], "conditions": ["C4", "C6"]},
    "replication": {"information": "IC-b", "budget": "MEDIUM", "action_mode": "free_form_managerial_9d", "conditions": ["C4", "C4R", "C6"], "replicate_id": 2},
