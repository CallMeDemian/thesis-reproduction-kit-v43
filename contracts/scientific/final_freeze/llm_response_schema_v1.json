{
  "schema_version": "llm_confirmatory_response_schema_v1",
  "free_form_managerial_9d": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mode", "diagnosis", "action_vector", "reference_response", "confidence", "brief_rationale"],
    "properties": {
      "mode": {"type": "string", "enum": ["free_form_managerial_9d"]},
      "diagnosis": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary_weakness", "evidence_feature_keys"],
        "properties": {
          "primary_weakness": {"type": "string"},
          "evidence_feature_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        }
      },
      "action_vector": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ppe_pct", "inv_turnover_chg", "ar_turnover_chg", "ap_turnover_chg", "short_debt_pct", "long_debt_pct", "bond_pct", "cogs_ratio_chg", "sga_ratio_chg"],
        "properties": {
          "ppe_pct": {"type": "number"},
          "inv_turnover_chg": {"type": "number"},
          "ar_turnover_chg": {"type": "number"},
          "ap_turnover_chg": {"type": "number"},
          "short_debt_pct": {"type": "number"},
          "long_debt_pct": {"type": "number"},
          "bond_pct": {"type": "number"},
          "cogs_ratio_chg": {"type": "number"},
          "sga_ratio_chg": {"type": "number"}
        }
      },
      "reference_response": {"type": "string", "enum": ["not_shown", "retained", "partially_adopted", "adopted", "rejected"]},
      "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
      "brief_rationale": {"type": "string"}
    }
  },
  "candidate_selection": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mode", "diagnosis", "selected_candidate", "reference_response", "confidence", "brief_rationale"],
    "properties": {
      "mode": {"type": "string", "enum": ["candidate_selection"]},
      "diagnosis": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary_weakness", "evidence_feature_keys"],
        "properties": {
          "primary_weakness": {"type": "string"},
          "evidence_feature_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        }
      },
      "selected_candidate": {
        "type": "string",
        "enum": ["A0_noop", "DL1_deleverage_mild", "DL2_deleverage_moderate", "RF1_short_debt_refinance", "CX1_capex_discipline", "WC1_working_capital_tightening", "WC2_supplier_financing", "OE1_cost_efficiency_mild", "OE2_cost_efficiency_moderate", "MX1_cost_and_deleverage", "MX2_liquidity_rescue"]
      },
      "reference_response": {"type": "string", "enum": ["not_shown", "retained", "partially_adopted", "adopted", "rejected"]},
      "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
      "brief_rationale": {"type": "string"}
    }
  },
  "icc_prior_knowledge_probe": {
    "type": "object",
    "additionalProperties": false,
    "required": ["recognized", "familiarity", "numeric_recall_claimed", "recalled_2024_financial_value", "brief_basis"],
    "properties": {
      "recognized": {"type": "boolean"},
      "familiarity": {"type": "string", "enum": ["none", "low", "medium", "high"]},
      "numeric_recall_claimed": {"type": "boolean"},
      "recalled_2024_financial_value": {"type": ["number", "null"]},
      "brief_basis": {"type": "string"}
    }
  },
  "code_validation": {
    "brief_rationale_max_words": 100,
    "evidence_keys_must_be_subset_of_firm_state": true,
    "numeric_fields_must_be_finite": true,
    "dimension_bounds_checked_outside_schema": true,
    "budget_checked_outside_schema": true,
    "revenue_growth_is_not_an_llm_field": true
  }
}
