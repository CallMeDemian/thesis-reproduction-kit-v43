FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3-pip && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/thesis-reproduction-kit-v43
COPY . .
RUN python3.11 -m pip install --no-cache-dir -e ".[data,dev]" && python3.11 -m pip install --no-cache-dir -r requirements/rl-cu124.lock.txt
ENTRYPOINT ["python3.11", "-m", "thesis_repro"]
